# ---- Dashboard server ----
PORT=3000
# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=random-string

# ---- Wazuh indexer (OpenSearch) - alerts ----
# This is the Wazuh indexer, NOT the Wazuh manager API (port 55000).
# Alerts live in the indexer's wazuh-alerts-* index.
WAZUH_INDEXER_HOST=127.0.0.1
WAZUH_INDEXER_PORT=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASS=
WAZUH_INDEXER_INDEX=wazuh-alerts-*
# Set to "false" only if your indexer has a trusted (non self-signed) cert
WAZUH_INDEXER_TLS_REJECT_UNAUTHORIZED=false

# Minimum Wazuh rule level to show (7 = medium and above in the default ruleset)
MIN_LEVEL=7
# How often the dashboard polls for new alerts, in ms
POLL_INTERVAL_MS=
# Max alerts to pull per refresh
ALERTS_LIMIT=100

# ---- Wazuh MANAGER API - used to register/remove agents for devices ----
# Different service from the indexer above, default port 55000.
WAZUH_API_HOST=127.0.0.1
WAZUH_API_PORT=
# Default Wazuh API user is usually "wazuh-wui" (dashboard) or "wazuh" - check your install.
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=
WAZUH_API_TLS_REJECT_UNAUTHORIZED=false

# ---- GVM / OpenVAS (Greenbone) ----
# The gvmd GMP socket, usually exposed on TCP 9390 over TLS
GVM_HOST=127.0.0.1
GVM_PORT=
GVM_USER=
GVM_PASS=
# Set to "false" only if gvmd's cert is trusted (not self-signed)
GVM_TLS_REJECT_UNAUTHORIZED=false

GVM_USE_TLS=false
GVM_CONFIG_PREFIX=ATLAS
